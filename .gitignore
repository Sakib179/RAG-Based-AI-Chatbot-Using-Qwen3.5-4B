# Node.js dependencies and package-manager caches
node_modules/
.npm/
.pnpm-store/
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Frontend build output
.next/
out/
.turbo/
*.tsbuildinfo

# Python bytecode, packaging, and virtual environments
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.Python
.venv/
venv/
env/
ENV/
__pypackages__/
build/
dist/
pip-wheel-metadata/

# Environment files: commit templates only
.env
.env.*
!.env.example
!.env.*.example

# Test, lint, type-check, and tool caches
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage/
htmlcov/

# Local runtime data
*.log
logs/
*.pid
*.sqlite
*.sqlite3
*.sqlite-journal
*.db
chroma_data/
.chroma/

# Keep local knowledge documents out of source control
/knowledge_base/*
!/knowledge_base/.gitkeep

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~

# macOS and Windows metadata
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
